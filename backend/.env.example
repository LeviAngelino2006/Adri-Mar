PORT=3000

# Base de datos (Prisma / PostgreSQL - Neon)
DATABASE_URL="postgresql://usuario:contrasena@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:contrasena@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Duracion de sesion por inactividad (minutos)
SESSION_TTL_CHOFER_MIN=720
SESSION_TTL_OTROS_MIN=60

# Administrador inicial (usado por backend/prisma/seed.js)
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Sistema
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena

# Supabase Storage (Almacenamiento de PDFs de documentación)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_BUCKET_NAME=documentacion

# Google Maps Platform (buscar direcciones y lugares al cargar un recorrido y
# calcular los km estimados). En el proyecto de Google Cloud hay que habilitar
# Places API (New) y Routes API, y conviene restringir la key a esas dos APIs.
# NUNCA va en el front ni en el repo: el backend la manda en el header
# X-Goog-Api-Key. Sin ella, los endpoints de Google responden 503 y el resto de
# la app (incluido el buscador de ubicaciones frecuentes) funciona igual.
GOOGLE_MAPS_API_KEY=
