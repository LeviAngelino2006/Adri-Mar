PORT=3000

# Base de datos (Prisma / PostgreSQL - Neon)
DATABASE_URL="postgresql://usuario:contrasena@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:contrasena@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Duracion de sesion por inactividad (minutos)
SESSION_TTL_CHOFER_MIN=720
SESSION_TTL_OTROS_MIN=60

# Administrador inicial (usado por backend/prisma/seed.js)
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Sistema
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena

# Supabase Storage (Almacenamiento de PDFs de documentación)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_BUCKET_NAME=documentacion
