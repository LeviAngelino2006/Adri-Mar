generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Perfil {
  id          Int       @id @default(autoincrement()) @map("id_perfil")
  descripcion String    @unique
  usuarios    Usuario[]

  @@map("perfiles")
}

model EstadoUsuario {
  id          Int       @id @default(autoincrement()) @map("id_estadousuario")
  descripcion String    @unique
  usuarios    Usuario[]

  @@map("estado_usuario")
}

model Usuario {
  id                     Int               @id @default(autoincrement())
  nombre                 String
  apellido               String
  nombreUsuario          String            @unique @map("nombre_usuario")
  contrasenaHash         String            @map("contrasena_hash")
  perfilId               Int               @map("perfil_id")
  perfil                 Perfil            @relation(fields: [perfilId], references: [id])
  dni                    String?           @unique
  email                  String?           @unique
  telefono               String?
  estadoUsuarioId        Int               @map("estado_usuario_id")
  estadoUsuario          EstadoUsuario     @relation(fields: [estadoUsuarioId], references: [id])
  habilitadoParaConducir Boolean           @default(false) @map("habilitado_para_conducir")
  creadoEn               DateTime          @default(now()) @map("creado_en")
  viajes                 Viaje[]
  lecturasOdometro       LecturaOdometro[]

  @@map("usuarios")
}

model TipoVehiculo {
  id          Int        @id @default(autoincrement()) @map("id_tipovehiculo")
  descripcion String     @unique
  vehiculos   Vehiculo[]

  @@map("tipos_vehiculo")
}

model EstadoVehiculo {
  id          Int        @id @default(autoincrement()) @map("id_estadovehiculo")
  descripcion String     @unique
  vehiculos   Vehiculo[]

  @@map("estado_vehiculo")
}

model Vehiculo {
  id               Int               @id @default(autoincrement())
  dominio          String            @unique
  numeroInterno    String            @map("numero_interno")
  marca            String
  modelo           String
  anio             Int
  asientos         Int
  kilometraje      Int
  estadoVehiculoId Int               @map("estado_vehiculo_id")
  estadoVehiculo   EstadoVehiculo    @relation(fields: [estadoVehiculoId], references: [id])
  tipoVehiculoId   Int               @map("tipo_vehiculo_id")
  tipoVehiculo     TipoVehiculo      @relation(fields: [tipoVehiculoId], references: [id])
  fechaBaja        DateTime?         @map("fecha_baja")
  creadoEn         DateTime          @default(now()) @map("creado_en")
  viajes           Viaje[]
  lecturasOdometro LecturaOdometro[]

  @@map("vehiculos")
}

model OrigenLectura {
  id          Int               @id @default(autoincrement()) @map("id_origenlectura")
  descripcion String            @unique
  lecturas    LecturaOdometro[]

  @@map("origenes_lectura")
}

model EstadoViaje {
  id          Int     @id @default(autoincrement()) @map("id_estadoviaje")
  descripcion String  @unique
  viajes      Viaje[]

  @@map("estado_viaje")
}

model Viaje {
  id                  Int               @id @default(autoincrement())
  choferId            Int               @map("chofer_id")
  chofer              Usuario           @relation(fields: [choferId], references: [id])
  vehiculoId          Int               @map("vehiculo_id")
  vehiculo            Vehiculo          @relation(fields: [vehiculoId], references: [id])
  fechaInicio         DateTime          @map("fecha_inicio")
  fechaFin            DateTime          @map("fecha_fin")
  kilometrosEstimados Int               @map("kilometros_estimados")
  odometroInicial     Int?              @map("odometro_inicial")
  odometroFinal       Int?              @map("odometro_final")
  estadoViajeId       Int               @map("estado_viaje_id")
  estadoViaje         EstadoViaje       @relation(fields: [estadoViajeId], references: [id])
  horaInicioReal      DateTime?         @map("hora_inicio_real")
  horaFinReal         DateTime?         @map("hora_fin_real")
  lecturasOdometro    LecturaOdometro[]
  creadoEn            DateTime          @default(now()) @map("creado_en")
  actualizadoEn       DateTime          @updatedAt @map("actualizado_en")

  @@map("viajes")
}

model Ubicacion {
  id                Int      @id @default(autoincrement())
  nombre            String
  // Calculado por normalizarNombre() al crear la fila. Nunca se expone en
  // la API, solo sirve para la garantía dura de no-duplicados (índice único
  // de abajo) contra la carrera entre dos requests simultáneos.
  nombreNormalizado String   @map("nombre_normalizado")
  creadoEn          DateTime @default(now()) @map("creado_en")

  @@index([nombre])
  @@unique([nombreNormalizado])
  @@map("ubicaciones")
}

model Cliente {
  id                Int      @id @default(autoincrement())
  nombre            String
  nombreNormalizado String   @map("nombre_normalizado")
  creadoEn          DateTime @default(now()) @map("creado_en")

  @@index([nombre])
  @@unique([nombreNormalizado])
  @@map("clientes")
}

model LecturaOdometro {
  id                 Int               @id @default(autoincrement())
  vehiculoId         Int               @map("vehiculo_id")
  vehiculo           Vehiculo          @relation(fields: [vehiculoId], references: [id])
  valorKm            Int               @map("valor_km")
  fechaHora          DateTime          @map("fecha_hora")
  origenId           Int               @map("origen_id")
  origen             OrigenLectura     @relation(fields: [origenId], references: [id])
  viajeId            Int?              @map("viaje_id")
  viaje              Viaje?            @relation(fields: [viajeId], references: [id])
  usuarioId          Int               @map("usuario_id")
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])
  lecturaCorregidaId Int?              @map("lectura_corregida_id")
  lecturaCorregida   LecturaOdometro?  @relation("CorreccionLectura", fields: [lecturaCorregidaId], references: [id])
  correcciones       LecturaOdometro[] @relation("CorreccionLectura")
  motivo             String?
  creadoEn           DateTime          @default(now()) @map("creado_en")

  @@index([vehiculoId, fechaHora])
  @@map("lecturas_odometro")
}
