generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Perfil {
  id          Int       @id @default(autoincrement()) @map("id_perfil")
  descripcion String    @unique
  usuarios    Usuario[]

  @@map("perfiles")
}

model EstadoUsuario {
  id          Int       @id @default(autoincrement()) @map("id_estadousuario")
  descripcion String    @unique
  usuarios    Usuario[]

  @@map("estado_usuario")
}

model Usuario {
  id                     Int               @id @default(autoincrement())
  nombre                 String
  apellido               String
  nombreUsuario          String            @unique @map("nombre_usuario")
  contrasenaHash         String            @map("contrasena_hash")
  perfilId               Int               @map("perfil_id")
  perfil                 Perfil            @relation(fields: [perfilId], references: [id])
  dni                    String?           @unique
  email                  String?           @unique
  telefono               String?
  estadoUsuarioId        Int               @map("estado_usuario_id")
  estadoUsuario          EstadoUsuario     @relation(fields: [estadoUsuarioId], references: [id])
  habilitadoParaConducir Boolean           @default(false) @map("habilitado_para_conducir")
  creadoEn               DateTime          @default(now()) @map("creado_en")
  viajes                 Viaje[]
  lecturasOdometro       LecturaOdometro[]
  documentos             Documento[]       @relation("DocumentosDelChofer")
  documentosRegistrados  Documento[]       @relation("DocumentosRegistradosPor")
  viajesCandidato        ViajeChoferCandidato[]
  presupuestos           Presupuesto[]

  @@map("usuarios")
}

model TipoVehiculo {
  id          Int        @id @default(autoincrement()) @map("id_tipovehiculo")
  descripcion String     @unique
  orden       Int
  vehiculos   Vehiculo[]

  @@map("tipos_vehiculo")
}

model EstadoVehiculo {
  id          Int        @id @default(autoincrement()) @map("id_estadovehiculo")
  descripcion String     @unique
  vehiculos   Vehiculo[]

  @@map("estado_vehiculo")
}

model Vehiculo {
  id               Int               @id @default(autoincrement())
  dominio          String            @unique
  numeroInterno    String            @map("numero_interno")
  // Solo el modelo: la marca se obtiene por modelo.marca. Guardar también
  // marcaId permitiría un vehículo con una marca que no es la de su modelo.
  // onDelete: Restrict: no se puede borrar un modelo que usa algún vehículo.
  modeloId         Int               @map("modelo_id")
  modelo           Modelo            @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  // true = el vehículo se compró usado: el historial de mantenimiento previo
  // a su incorporación a la flota es desconocido (lo que se registra en el
  // sistema arranca el día del alta, no cuando el vehículo era 0 km).
  adquiridoUsado   Boolean           @default(false) @map("adquirido_usado")
  anio             Int
  asientos         Int
  kilometraje      Int
  estadoVehiculoId Int               @map("estado_vehiculo_id")
  estadoVehiculo   EstadoVehiculo    @relation(fields: [estadoVehiculoId], references: [id])
  tipoVehiculoId   Int               @map("tipo_vehiculo_id")
  tipoVehiculo     TipoVehiculo      @relation(fields: [tipoVehiculoId], references: [id])
  fechaBaja        DateTime?         @map("fecha_baja")
  creadoEn         DateTime          @default(now()) @map("creado_en")
  viajes           Viaje[]
  lecturasOdometro LecturaOdometro[]
  documentos       Documento[]
  viajesCandidato  ViajeVehiculoCandidato[]
  presupuestoUnidades PresupuestoUnidad[]

  @@map("vehiculos")
}

// Catálogo de marcas de vehículo, con el mismo patrón "buscar o crear" que
// Cliente y Ubicacion: nombreNormalizado lo calcula normalizarNombre() al crear
// la fila, nunca se expone en la API y es la garantía dura de no-duplicados
// ("Mercedes-Benz" y "MERCEDES-BENZ" son la misma marca).
model Marca {
  id                Int      @id @default(autoincrement())
  nombre            String
  nombreNormalizado String   @map("nombre_normalizado")
  creadoEn          DateTime @default(now()) @map("creado_en")
  modelos           Modelo[]

  @@index([nombre])
  @@unique([nombreNormalizado])
  @@map("marcas")
}

// Modelo de una marca. El único es por (marca, nombre normalizado): el mismo
// nombre de modelo puede existir en marcas distintas ("Daily" de Iveco y de
// otra marca son dos filas). onDelete: Restrict: no se borra una marca con
// modelos.
model Modelo {
  id                Int        @id @default(autoincrement())
  nombre            String
  nombreNormalizado String     @map("nombre_normalizado")
  marcaId           Int        @map("marca_id")
  marca             Marca      @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  creadoEn          DateTime   @default(now()) @map("creado_en")
  vehiculos         Vehiculo[]

  @@index([nombre])
  @@unique([marcaId, nombreNormalizado])
  @@map("modelos")
}

model OrigenLectura {
  id          Int               @id @default(autoincrement()) @map("id_origenlectura")
  descripcion String            @unique
  lecturas    LecturaOdometro[]

  @@map("origenes_lectura")
}

model EstadoViaje {
  id          Int     @id @default(autoincrement()) @map("id_estadoviaje")
  descripcion String  @unique
  viajes      Viaje[]

  @@map("estado_viaje")
}

// Reusado tal cual para el pago al cliente y el pago al chofer (dos FK
// distintas en Viaje, mismo catálogo de valores: PENDIENTE/PAGADO/PARCIAL).
model EstadoPago {
  id                        Int     @id @default(autoincrement()) @map("id_estadopago")
  descripcion               String  @unique
  viajesEstadoPagoCliente   Viaje[] @relation("ViajeEstadoPagoCliente")
  viajesEstadoPagoChofer    Viaje[] @relation("ViajeEstadoPagoChofer")

  @@map("estado_pago")
}

// Reusado tal cual para el pago al cliente y el pago al chofer (dos FK
// distintas en Viaje, mismo catálogo de valores: EFECTIVO/BANCO/CHEQUE).
model MetodoPago {
  id                        Int     @id @default(autoincrement()) @map("id_metodopago")
  descripcion               String  @unique
  viajesMetodoPagoCliente   Viaje[] @relation("ViajeMetodoPagoCliente")
  viajesMetodoPagoChofer    Viaje[] @relation("ViajeMetodoPagoChofer")

  @@map("metodo_pago")
}

model Viaje {
  id                  Int               @id @default(autoincrement())
  // Nullable porque un viaje A_CONFIRMAR puede no tener ninguno de estos 5
  // todavía (se completan al editar o al confirmar). Un viaje PROGRAMADO (o
  // posterior) siempre los tiene — esa garantía la sostiene viajeService, no
  // la base.
  choferId            Int?              @map("chofer_id")
  // onDelete: Restrict explícito — al volverse opcional, Prisma por defecto
  // pasaría a SET NULL en el DELETE, lo que dejaría borrar un usuario/vehículo
  // con viajes encima (y un viaje PROGRAMADO podría quedar sin chofer). Se
  // preserva el comportamiento de siempre (no se puede borrar un usuario o
  // vehículo que tiene viajes).
  chofer              Usuario?          @relation(fields: [choferId], references: [id], onDelete: Restrict)
  vehiculoId          Int?              @map("vehiculo_id")
  vehiculo            Vehiculo?         @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  // Nullable porque los viajes históricos no tienen este dato y no hay forma
  // de reconstruirlo retroactivamente. La obligatoriedad para viajes nuevos (y
  // al editar, en cualquier estado) se valida en viajeService, no acá.
  fechaInicio         DateTime?         @map("fecha_inicio")
  fechaFin            DateTime?         @map("fecha_fin")
  kilometrosEstimados Int?              @map("kilometros_estimados")
  // Dato informativo, opcional en todos los estados: no se valida contra
  // Vehiculo.asientos ni restringe nada.
  cantidadPasajeros   Int?              @map("cantidad_pasajeros")
  odometroInicial     Int?              @map("odometro_inicial")
  odometroFinal       Int?              @map("odometro_final")
  estadoViajeId       Int               @map("estado_viaje_id")
  estadoViaje         EstadoViaje       @relation(fields: [estadoViajeId], references: [id])
  horaInicioReal      DateTime?         @map("hora_inicio_real")
  horaFinReal         DateTime?         @map("hora_fin_real")
  // Nota libre opcional que se carga ÚNICAMENTE al finalizar el viaje (ver
  // finalizarViaje); no hay forma de editarla después. El límite de longitud
  // lo valida viajeService (no la base), igual que el resto de los textos.
  observacionFinal    String?           @map("observacion_final")
  lecturasOdometro    LecturaOdometro[]
  // Choferes y vehículos posibles mientras el viaje está A_CONFIRMAR. Al
  // confirmar se elige uno de cada uno (choferId/vehiculoId) y estas filas se
  // borran en la misma transacción: no se guardan como historial.
  choferesCandidatos  ViajeChoferCandidato[]
  vehiculosCandidatos ViajeVehiculoCandidato[]
  // Puntos intermedios ORDENADOS entre origen y destino (ver ViajeParada).
  paradas             ViajeParada[]
  // Nullable porque los viajes históricos no tienen este dato y no hay forma
  // de reconstruirlo retroactivamente (quedan en null para siempre). La
  // obligatoriedad para viajes nuevos se valida en viajeService, no acá.
  origenId            Int?              @map("origen_id")
  origen              Ubicacion?        @relation("ViajeOrigen", fields: [origenId], references: [id])
  destinoId           Int?              @map("destino_id")
  destino             Ubicacion?        @relation("ViajeDestino", fields: [destinoId], references: [id])
  // Datos administrativos (Precio/Cliente/pagos): acción aparte, independiente
  // del estado del viaje, cargada de a poco por Administrador/Encargado desde
  // PATCH /viajes/:id/datos-administrativos — por eso van todos nullable acá
  // también (no solo por los viajes históricos, sino porque un viaje nuevo
  // tampoco los tiene el día que se programa).
  precio              Decimal?          @db.Decimal(12, 2)
  clienteId           Int?              @map("cliente_id")
  cliente             Cliente?          @relation(fields: [clienteId], references: [id])
  estadoPagoClienteId Int?              @map("estado_pago_cliente_id")
  estadoPagoCliente   EstadoPago?       @relation("ViajeEstadoPagoCliente", fields: [estadoPagoClienteId], references: [id])
  fechaPagoCliente    DateTime?         @map("fecha_pago_cliente")
  metodoPagoClienteId Int?              @map("metodo_pago_cliente_id")
  metodoPagoCliente   MetodoPago?       @relation("ViajeMetodoPagoCliente", fields: [metodoPagoClienteId], references: [id])
  pagoChofer          Decimal?          @db.Decimal(12, 2) @map("pago_chofer")
  estadoPagoChoferId  Int?              @map("estado_pago_chofer_id")
  estadoPagoChofer    EstadoPago?       @relation("ViajeEstadoPagoChofer", fields: [estadoPagoChoferId], references: [id])
  fechaPagoChofer     DateTime?         @map("fecha_pago_chofer")
  metodoPagoChoferId  Int?              @map("metodo_pago_chofer_id")
  metodoPagoChofer    MetodoPago?       @relation("ViajeMetodoPagoChofer", fields: [metodoPagoChoferId], references: [id])
  creadoEn            DateTime          @default(now()) @map("creado_en")
  actualizadoEn       DateTime          @updatedAt @map("actualizado_en")

  @@map("viajes")
}

model Ubicacion {
  id                Int      @id @default(autoincrement())
  nombre            String
  // FRECUENTE (true): localidades de Georef, aeropuerto, colegios, hoteles;
  // aparecen en el buscador de ubicaciones. PARTICULAR (false): la casa de un
  // pasajero, creada al elegir una dirección de Google; NO aparece en el
  // buscador y su nombre es la dirección.
  esFrecuente       Boolean  @default(true) @map("es_frecuente")
  // Calculado por normalizarNombre() al crear la fila. Nunca se expone en
  // la API, solo sirve para la garantía dura de no-duplicados (índice único
  // de abajo) contra la carrera entre dos requests simultáneos. Solo lo tienen
  // las frecuentes: las particulares van con null (Postgres admite varios null
  // en un índice único), así dos casas no chocan por nombre.
  nombreNormalizado String?  @map("nombre_normalizado")
  // Punto en el mapa (grados decimales, WGS84) con el que se calculan los km
  // estimados de un viaje cuando la ubicación no tiene placeId (las
  // localidades de Georef). Las que vienen de Google NO lo guardan: los
  // términos de Google solo permiten guardar el placeId sin límite de tiempo.
  latitud           Float?
  longitud          Float?
  // Place ID de Google Maps si la ubicación se eligió en el buscador de Google
  // (o se completó con él). Es lo único de Google que se puede guardar sin
  // límite; con él se calculan los km (Routes API) y se arma el link al
  // recorrido. Único: elegir dos veces la misma dirección no duplica la fila.
  placeId           String?  @unique @map("place_id")
  // Dirección formateada de Google. Por ahora siempre null: no se guarda por
  // los mismos términos (ver placeId); la columna queda para cuando haya una
  // fuente propia de la dirección.
  direccion         String?
  // Id de la localidad en la API Georef (datos.gob.ar) si la fila vino de
  // scripts/importarLocalidadesCordoba.js o se completó con ella. Único, para
  // que correr la importación de nuevo no duplique localidades. Nulo en los
  // puntos de interés cargados a mano (colegios, hoteles, etc.).
  georefId          String?  @unique @map("georef_id")
  creadoEn          DateTime @default(now()) @map("creado_en")
  viajesOrigen      Viaje[]  @relation("ViajeOrigen")
  viajesDestino     Viaje[]  @relation("ViajeDestino")
  viajesParada      ViajeParada[]
  presupuestosOrigen  Presupuesto[] @relation("PresupuestoOrigen")
  presupuestosDestino Presupuesto[] @relation("PresupuestoDestino")

  @@index([nombre])
  @@unique([nombreNormalizado])
  @@map("ubicaciones")
}

model Cliente {
  id                Int      @id @default(autoincrement())
  nombre            String
  nombreNormalizado String   @map("nombre_normalizado")
  creadoEn          DateTime @default(now()) @map("creado_en")
  viajes            Viaje[]
  presupuestos      Presupuesto[]

  @@index([nombre])
  @@unique([nombreNormalizado])
  @@map("clientes")
}

model LecturaOdometro {
  id                 Int               @id @default(autoincrement())
  vehiculoId         Int               @map("vehiculo_id")
  vehiculo           Vehiculo          @relation(fields: [vehiculoId], references: [id])
  valorKm            Int               @map("valor_km")
  fechaHora          DateTime          @map("fecha_hora")
  origenId           Int               @map("origen_id")
  origen             OrigenLectura     @relation(fields: [origenId], references: [id])
  viajeId            Int?              @map("viaje_id")
  viaje              Viaje?            @relation(fields: [viajeId], references: [id])
  usuarioId          Int               @map("usuario_id")
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])
  lecturaCorregidaId Int?              @map("lectura_corregida_id")
  lecturaCorregida   LecturaOdometro?  @relation("CorreccionLectura", fields: [lecturaCorregidaId], references: [id])
  correcciones       LecturaOdometro[] @relation("CorreccionLectura")
  motivo             String?
  creadoEn           DateTime          @default(now()) @map("creado_en")

  @@index([vehiculoId, fechaHora])
  @@map("lecturas_odometro")
}

// Catálogo: a qué se le carga un documento. Valores: VEHICULO, CHOFER.
model CategoriaDocumento {
  id             Int             @id @default(autoincrement()) @map("id_categoriadocumento")
  descripcion    String          @unique
  tiposDocumento TipoDocumento[]

  @@map("categoria_documento")
}

// Catálogo: qué documentos existen y qué exige cada uno. descripcion es el
// código (POLIZA_SEGURO, ITV, LICENCIA_CONDUCIR…); la etiqueta visible vive
// en el front, igual que los estados de vehículo y viaje.
model TipoDocumento {
  id                   Int                @id @default(autoincrement()) @map("id_tipodocumento")
  descripcion          String             @unique
  categoriaDocumentoId Int                @map("categoria_documento_id")
  categoriaDocumento   CategoriaDocumento @relation(fields: [categoriaDocumentoId], references: [id])
  requiereVencimiento  Boolean            @map("requiere_vencimiento")
  requiereArchivo      Boolean            @map("requiere_archivo")
  // Días de anticipación con los que un documento vigente de este tipo pasa a
  // "Por vencer" (el pago del seguro avisa con 5; el resto con 30). Se compara
  // contra la fecha de vencimiento en hora de Córdoba; ver documentoService.
  diasAviso            Int                @map("dias_aviso")
  documentos           Documento[]

  @@map("tipos_documento")
}

// Cada fila es una versión cargada de un documento. Pertenece a un vehículo O
// a un chofer, nunca a los dos (CHECK documentos_un_solo_titular en la
// migración). La versión vigente es la más reciente por titular y tipo: no se
// guarda, se calcula. Que la categoría del tipo coincida con el titular lo
// valida documentoService, no la base.
// onDelete: Restrict explícito en vehiculo y chofer: al ser opcionales, Prisma
// pasaría a SET NULL, y dejar ambas columnas en null violaría el CHECK. Se
// preserva el comportamiento de siempre (no se puede borrar un vehículo ni un
// usuario que tiene documentos).
model Documento {
  id               Int           @id @default(autoincrement())
  tipoDocumentoId  Int           @map("tipo_documento_id")
  tipoDocumento    TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  vehiculoId       Int?          @map("vehiculo_id")
  vehiculo         Vehiculo?     @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  choferId         Int?          @map("chofer_id")
  chofer           Usuario?      @relation("DocumentosDelChofer", fields: [choferId], references: [id], onDelete: Restrict)
  archivoPath      String?       @map("archivo_path")
  nombreArchivo    String?       @map("nombre_archivo")
  fechaEmision     DateTime?     @map("fecha_emision")
  fechaVencimiento DateTime?     @map("fecha_vencimiento")
  observaciones    String?
  usuarioId        Int           @map("usuario_id")
  usuario          Usuario       @relation("DocumentosRegistradosPor", fields: [usuarioId], references: [id])
  creadoEn         DateTime      @default(now()) @map("creado_en")

  @@index([vehiculoId, tipoDocumentoId, creadoEn])
  @@index([choferId, tipoDocumentoId, creadoEn])
  @@map("documentos")
}

// Chofer posible para un viaje A_CONFIRMAR. Viaje.choferId sigue siendo "el
// asignado" y queda en null hasta confirmar. Cascade al borrar el viaje;
// Restrict al borrar el usuario (mismo criterio que Viaje.choferId).
model ViajeChoferCandidato {
  viajeId   Int     @map("viaje_id")
  usuarioId Int     @map("usuario_id")
  viaje     Viaje   @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@id([viajeId, usuarioId])
  @@map("viaje_chofer_candidato")
}

model ViajeVehiculoCandidato {
  viajeId    Int      @map("viaje_id")
  vehiculoId Int      @map("vehiculo_id")
  viaje      Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)

  @@id([viajeId, vehiculoId])
  @@map("viaje_vehiculo_candidato")
}

// Punto intermedio de un viaje, entre origen y destino. Sirve para estimar
// kilómetros, tiempo y presupuesto: no tiene datos propios (ni hora, ni
// pasajeros), no cambia chofer ni vehículo, no registra odómetro y el chofer no
// interactúa con ella. `orden` (1..n) lo asigna viajeService según la posición
// en el arreglo recibido. Una misma ubicación puede repetirse en un viaje
// mientras no sea consecutiva (ida y vuelta). Cascade al borrar el viaje;
// Restrict al borrar la ubicación.
model ViajeParada {
  id          Int       @id @default(autoincrement())
  viajeId     Int       @map("viaje_id")
  ubicacionId Int       @map("ubicacion_id")
  orden       Int
  viaje       Viaje     @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)

  @@unique([viajeId, orden])
  @@map("viaje_paradas")
}

// Presupuesto para un cliente potencial (SCRUM-159). No tiene relación con la
// gestión de viajes: no crea ni modifica viajes, solo reusa los catálogos de
// Cliente, Ubicacion y Vehiculo. No se edita ni se elimina: para cambiar algo
// se duplica. Todo lo que sale en el PDF se arma con datos guardados acá, así
// re-descargarlo da siempre el mismo documento.
model Presupuesto {
  id                Int                 @id @default(autoincrement())
  fechaEmision      DateTime            @map("fecha_emision") @db.Date
  clienteId         Int                 @map("cliente_id")
  cliente           Cliente             @relation(fields: [clienteId], references: [id])
  origenId          Int                 @map("origen_id")
  origen            Ubicacion           @relation("PresupuestoOrigen", fields: [origenId], references: [id])
  destinoId         Int                 @map("destino_id")
  destino           Ubicacion           @relation("PresupuestoDestino", fields: [destinoId], references: [id])
  fechaServicio     DateTime            @map("fecha_servicio") @db.Date
  // "HH:mm" en hora de Córdoba. null = "A confirmar".
  horaSalida        String?             @map("hora_salida")
  cantidadPasajeros Int                 @map("cantidad_pasajeros")
  importeNeto       Decimal             @map("importe_neto") @db.Decimal(12, 2)
  conFactura        Boolean             @default(false) @map("con_factura")
  // Se guarda en cada presupuesto (no se lee de una constante al regenerar)
  // para que, si cambia la alícuota, los presupuestos viejos salgan igual.
  alicuotaIva       Decimal             @default(10.50) @map("alicuota_iva") @db.Decimal(4, 2)
  formaPago         String              @map("forma_pago")
  // Días de validez a partir de fechaEmision (1..365).
  diasValidez       Int                 @map("dias_validez")
  creadoPorId       Int                 @map("creado_por_id")
  creadoPor         Usuario             @relation(fields: [creadoPorId], references: [id])
  creadoEn          DateTime            @default(now()) @map("creado_en")
  unidades          PresupuestoUnidad[]

  @@index([creadoEn])
  @@map("presupuestos")
}

// Unidad (vehículo) ofrecida en un presupuesto. `descripcion` es un snapshot
// ("Minibus de 17 pasajeros") armado por presupuestoService al crear: si después
// cambian el tipo o los asientos del vehículo, el PDF de un presupuesto viejo
// sale igual que el que se mandó (CA9 de SCRUM-159). Cascade al borrar el
// presupuesto; Restrict al borrar el vehículo.
model PresupuestoUnidad {
  id            Int         @id @default(autoincrement())
  presupuestoId Int         @map("presupuesto_id")
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  vehiculoId    Int         @map("vehiculo_id")
  vehiculo      Vehiculo    @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  descripcion   String
  orden         Int

  @@unique([presupuestoId, orden])
  @@unique([presupuestoId, vehiculoId])
  @@map("presupuesto_unidades")
}
